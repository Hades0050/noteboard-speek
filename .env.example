# Сервер
ADDR=:8080
DATA_DIR=./data

# Расшифровка голоса — вариант 1: OpenAI-совместимый HTTP API
# (подходит OpenAI, faster-whisper-server, whisper.cpp server, любой совместимый)
#TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
#TRANSCRIBE_API_KEY=sk-...
#TRANSCRIBE_MODEL=whisper-1

# Расшифровка голоса — вариант 2: локальный whisper.cpp (нужен ещё ffmpeg)
#WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
#WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo.bin
#FFMPEG_BIN=ffmpeg

TRANSCRIBE_LANG=ru

# Подсказка модели: имена коллег, продукты, термины. Заметно чинит имена собственные.
#TRANSCRIBE_PROMPT=Дима Санечков, виртуализация, Sandbox, Nuxt, канбан

# Те же слова как hotwords: точнее prompt, но понимает только faster-whisper/speaches.
#TRANSCRIBE_HOTWORDS=Санечков, Sandbox, Nuxt

# Отрезать тишину и шум перед распознаванием — меньше выдуманных фраз на паузах.
#TRANSCRIBE_VAD=true
